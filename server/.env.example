# Corridor server environment. Copy to server/.env and fill in real values.
# Load in your process manager or with `export $(grep -v '^#' .env | xargs)`.

# ---- WhatsApp Business Cloud API (Meta) ----
# developers.facebook.com -> your app -> WhatsApp -> API Setup.
# WA_VERIFY_TOKEN is any string you choose; enter the SAME string in the Meta
# webhook config. WA_ACCESS_TOKEN + WA_PHONE_NUMBER_ID come from API Setup.
WA_VERIFY_TOKEN=choose-a-verify-token
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v20.0

# Public HTTPS URL Meta will call (the webhook). For a laptop demo use a tunnel
# (e.g. `ngrok http 4000`) and register https://<tunnel>/wa/webhook in Meta.
PUBLIC_BASE_URL=

# ---- Ops control channel (/ws) ----
# Required to send CONTROL commands from a REMOTE machine. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Blank = localhost-only control (secure default). Two-person reset for
# monitor_reset should be enforced operationally.
OPS_TOKEN=

# ---- Google Maps (call-taker console: Places autocomplete + geocoding) ----
# Enable Maps JavaScript API + Places API + Geocoding API; allow localhost referrer.
# Leave blank to fall back to typing 'lat, lng' (offline) or server-side Nominatim.
GOOGLE_MAPS_API_KEY=

# ---- Server ----
SERVER_PORT=4000
