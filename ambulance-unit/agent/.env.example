# Central corridor server (Socket.IO gateway). Point at the real server host.
CLOUD_URL=http://localhost:4000

# Device identity + credential. Provision a UNIQUE random secret per vehicle and
# add the matching entry to server/config.yaml -> security.devices:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_ID=AMB-CHN-001
DEVICE_SECRET=REPLACE_WITH_PROVISIONED_SECRET

# Local bridge the dashboard connects to
UI_BRIDGE_HOST=127.0.0.1
UI_BRIDGE_PORT=8765

# GPS: 'phone' (real browser GPS streamed from the dashboard) or 'serial' (NEO-M8N)
GPS_MODE=phone
GPS_SERIAL_PORT=/dev/serial0
GPS_BAUD=9600

TELEMETRY_HZ=1

# Simulation centre (Chennai) + default patient condition behaviour
HOME_LAT=13.0827
HOME_LNG=80.2707
DEFAULT_CONDITION=code_red
CONDITION_TIMEOUT_SEC=10
