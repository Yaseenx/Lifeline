# Where the dashboard reaches the on-device agent (the localhost UI bridge).
VITE_AGENT_WS_URL=ws://localhost:8765

# Google Maps JavaScript API key (primary map). If omitted, left as this
# placeholder, or rejected by Google, the dashboard automatically falls back
# to a keyless Leaflet + OpenStreetMap map — so the map always renders.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional / currently unused: cloud-styled Map ID. The dark theme is applied
# via inline styles, so no Map ID is required.
VITE_GOOGLE_MAPS_MAP_ID=
