# ───────────── Secrets — NEVER commit ─────────────
# Matches .env at any depth (server/.env, ambulance-unit/agent/.env,
# ambulance-unit/dashboard/.env, etc). Templates (*.env.example) are kept.
.env
.env.*
*.env
!.env.example
!*.env.example

# ───────────── Python ─────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ───────────── Node / Vite dashboard ─────────────
node_modules/
dist/
build/
.vite/
*.local

# ───────────── Runtime / data that shouldn't be in VCS ─────────────
*.log
logs/

# ───────────── OS / editor ─────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
